{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "UartBridge",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "UART_BRIDGE": "ON"
            }
        },
        {
            "name": "CanDiscovery",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CAN_DISCOVERY": "ON",
                "UART_BRIDGE": "OFF"
            }
        },
        {
            "name": "SixMotor",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "UART_BRIDGE": "OFF",
                "CAN_DISCOVERY": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "UartBridge",
            "configurePreset": "UartBridge"
        },
        {
            "name": "CanDiscovery",
            "configurePreset": "CanDiscovery"
        },
        {
            "name": "SixMotor",
            "configurePreset": "SixMotor"
        }
    ]
}
